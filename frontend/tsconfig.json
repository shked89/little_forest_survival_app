{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@": [
        "./src"
      ],
      "@/*": [
        "./src/*"
      ]
    },

    "strict": true,

    "allowJs": true,
    "checkJs": false,

    "verbatimModuleSyntax": true,

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "types": [
      "vite/client"
    ],

    "skipLibCheck": true,
    "noEmit": true
  },

  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "tests/**/*.js",
    "tests/**/*.ts"
  ]
}